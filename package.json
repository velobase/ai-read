{
  "name": "bypage",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first multilingual reader with source-grounded AI companionship.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs dev",
    "build": "node scripts/prepare-pdf.mjs && NEXT_TELEMETRY_DISABLED=1 next build",
    "typecheck": "NEXT_TELEMETRY_DISABLED=1 next typegen && tsc --noEmit",
    "start": "node scripts/serve.mjs start",
    "postinstall": "prisma generate && node scripts/prepare-pdf.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:up": "docker compose up -d postgres",
    "check:observability": "node --conditions=react-server --experimental-strip-types scripts/check-observability.mjs",
    "mobile:install": "npm --prefix apps/mobile ci",
    "mobile:dev": "npm --prefix apps/mobile run dev",
    "mobile:ios": "npm --prefix apps/mobile run ios",
    "mobile:build": "npm --prefix apps/mobile run build",
    "mobile:typecheck": "npm --prefix apps/mobile run typecheck",
    "check:packages": "tsc -p packages/reading-core && tsc -p packages/api-client"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@google-cloud/storage": "^8.4.0",
    "@opentelemetry/api": "~1.10.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@xmldom/xmldom": "^0.9.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.8",
    "fflate": "^0.8.3",
    "jose": "^6.2.13",
    "lucide-react": "^1.59.0",
    "next": "^16.4.2",
    "next-auth": "5.0.0-beta.32",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-trace": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
