generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String    @id @default(uuid())
  name                String?
  email               String    @unique
  emailVerified       DateTime?
  image               String?
  isAdmin             Boolean   @default(false)
  translationPrompt   String    @default("")
  bio                 String    @default("")
  color               String    @default("#77a98c")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  accounts            Account[]
  sessions            Session[]
  preferences         Json      @default("{}")
  preferencesVersion  Int       @default(0)
  preferencesMutation String?
  books               Book[]
  aiConnection        AIConnection?
  translationEditions TranslationEdition[]
  translationSelections TranslationSelection[]
}

model AIConnection {
  userId       String   @id
  baseUrl      String
  model        String
  encryptedKey String?
  translationPrompt String @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// IDs remain compatible with existing IndexedDB books. Ownership is part of every key.
model Book {
  userId       String
  id           String
  sourceHash   String
  title        String
  content      Json
  shelfState   Json               @default("{}")
  version      Int                @default(1)
  mutationId   String
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  progress     ReadingProgress?
  notes        Note[]
  bookmarks    Bookmark[]
  chats        ChatTurn[]
  translations TranslationCache[]

  @@id([userId, id])
  @@unique([userId, sourceHash])
}

model ReadingProgress {
  userId     String
  bookId     String
  position   Json
  version    Int       @default(1)
  mutationId String
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  book       Book      @relation(fields: [userId, bookId], references: [userId, id], onDelete: Cascade)

  @@id([userId, bookId])
}

model Note {
  userId      String
  bookId      String
  id          String
  paragraphId String
  quote       String
  anchor      Json?
  content     String
  createdAt   DateTime
  version     Int       @default(1)
  mutationId  String
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  book        Book      @relation(fields: [userId, bookId], references: [userId, id], onDelete: Cascade)

  @@id([userId, bookId, id])
}

model Bookmark {
  userId     String
  bookId     String
  id         String
  body       Json
  createdAt  DateTime
  version    Int       @default(1)
  mutationId String
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  book       Book      @relation(fields: [userId, bookId], references: [userId, id], onDelete: Cascade)

  @@id([userId, bookId, id])
}

model ChatTurn {
  userId     String
  bookId     String
  id         String
  question   String
  answer     String
  sources    Json
  partial    Boolean   @default(false)
  createdAt  DateTime
  version    Int       @default(1)
  mutationId String
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  book       Book      @relation(fields: [userId, bookId], references: [userId, id], onDelete: Cascade)

  @@id([userId, bookId, id])
}

model TranslationCache {
  userId         String
  bookId         String
  id             String
  paragraphId    String
  targetLanguage String
  translation    String
  version        Int       @default(1)
  mutationId     String
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  book           Book      @relation(fields: [userId, bookId], references: [userId, id], onDelete: Cascade)

  @@id([userId, bookId, id])
}

// Published chapters are immutable. Jobs and their checkpoints survive HTTP
// disconnects and process restarts; a lease fences competing server instances.
model TranslationEdition {
  id             String @id
  userId         String
  bookId         String
  targetLanguage String
  sourceHash     String
  source         Json
  profile        Json
  glossary       Json @default("[]")
  state          String @default("idle")
  error          String?
  leaseToken     String?
  leaseUntil     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapters       TranslationChapter[]
  selections     TranslationSelection[]

  @@index([userId, bookId, targetLanguage, createdAt])
  @@index([state, leaseUntil])
}

model TranslationChapter {
  editionId      String
  chapterIndex   Int
  sourceHash     String
  state          String @default("missing")
  priority       Int @default(0)
  totalChunks    Int
  completedChunks Int @default(0)
  checkpoint     Json @default("[]")
  paragraphs     Json?
  attempts       Int @default(0)
  retryAt        DateTime?
  error          String?
  updatedAt      DateTime @updatedAt
  edition        TranslationEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@id([editionId, chapterIndex])
  @@index([editionId, state, priority])
}

model TranslationSelection {
  userId         String
  bookId         String
  targetLanguage String
  editionId      String
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  edition        TranslationEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@id([userId, bookId, targetLanguage])
}

model Account {
  id                String @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  encryptedAppleRefreshToken String?
  encryptedNativeAppleRefreshToken String?
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Consumed native sign-in challenges prevent replay across instances. No provider tokens are stored.
model NativeAuthUse {
  id      String   @id
  expires DateTime

  @@index([expires])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  device       String   @default("浏览器")
  kind         String   @default("web")
  origin       String?
  permissions  String[] @default(["account_ai"])
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

// Public catalog content is separate from each reader's private library.
model CatalogBook {
  id String @id @default(uuid())
  slug String @unique
  title String
  author String
  description String @default("")
  language String @default("en")
  category String @default("Classics")
  sourceUrl String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  editions CatalogEdition[]
  publication CatalogPublication?
  collections CatalogCollectionItem[]
}
model CatalogEdition {
  id String @id @default(uuid())
  bookId String
  state String @default("queued")
  chapterCount Int @default(0)
  paragraphCount Int @default(0)
  characterCount Int @default(0)
  warnings Json @default("[]")
  createdAt DateTime @default(now())
  book CatalogBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  assets CatalogAsset[]
  job CatalogImportJob?
  publication CatalogPublication?
}
model CatalogAsset {
  id String @id @default(uuid())
  editionId String
  kind String
  key String @unique
  mime String
  byteLength Int
  sha256 String
  fileName String
  edition CatalogEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  @@unique([editionId, kind])
}
model CatalogImportJob {
  id String @id @default(uuid())
  editionId String @unique
  state String @default("queued")
  error String?
  attempts Int @default(0)
  leaseToken String?
  leaseUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  edition CatalogEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  @@index([state, leaseUntil])
}
model CatalogPublication {
  bookId String @id
  editionId String @unique
  publishedAt DateTime @default(now())
  book CatalogBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  edition CatalogEdition @relation(fields: [editionId], references: [id], onDelete: Restrict)
}
model CatalogCollection {
  id String @id @default(uuid())
  title String
  description String @default("")
  sortOrder Int @default(0)
  items CatalogCollectionItem[]
}
model CatalogCollectionItem {
  collectionId String
  bookId String
  sortOrder Int @default(0)
  collection CatalogCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  book CatalogBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  @@id([collectionId, bookId])
}
