# Optional: configure a trusted OpenAI-compatible service here.
# Copy to .env (ignored by Git). No key is bundled with ByPage · 逐页.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# Account AI keys are encrypted in PostgreSQL with a distinct 32-byte base64 key.
# Keep this stable in a server-side Secret, separate from AUTH_SECRET.
AI_ENCRYPTION_KEY=
PORT=4173
# Local Ollama example (the model must already be installed):
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=your-installed-model

# Optional accounts: Auth.js + Google OAuth + PostgreSQL.
# AUTH_ENABLED=true fails closed if any required auth setting is missing.
# Without auth settings, the loopback-only local reader remains available.
AUTH_ENABLED=false
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
APP_ORIGIN=http://127.0.0.1:4173
# Generate distinct random values for AUTH_SECRET and POSTGRES_PASSWORD.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://ai_read:REPLACE_WITH_POSTGRES_PASSWORD@127.0.0.1:54341/ai_read?schema=public
# Google Web OAuth redirect URIs (register both for local development):
# http://127.0.0.1:4173/api/auth/callback/google
# http://localhost:4173/api/auth/callback/google
# In production set BOTH APP_ORIGIN and AUTH_URL to the canonical HTTPS origin.
# Standalone Next.js otherwise exposes its internal host to Auth.js route handlers.
# Keep AUTH_URL unset locally to support both loopback aliases.
# AUTH_URL=https://leafread.ai

# Observability: structured, content-free logs are on; 0 disables them.
OBSERVABILITY_LOGS=1
# Optional /api/metrics scrape token; at least 24 characters, server-side only.
OBSERVABILITY_METRICS_TOKEN=
# Optional OTLP HTTP trace collector. Empty = no traces leave the server.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_SERVICE_NAME=bypage
OTEL_TRACES_SAMPLE_RATIO=0.1
# Standard OTEL_EXPORTER_OTLP_TRACES_HEADERS may supply collector authentication.
# Optional anonymous analytics: BOTH settings + browser opt-in are required.
# Project token, never a personal API key. Region or self-hosted HTTPS origin.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=
# POSTHOG_HOST=https://eu.i.posthog.com
# Set to 1 for development/diagnostics that must never run account translation jobs.
TRANSLATION_WORKER_DISABLED=0
