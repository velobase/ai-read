# Optional: configure a trusted OpenAI-compatible service here.
# Copy to .env (ignored by Git). No key is bundled with ByPage · 逐页.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
PORT=4173
# Local Ollama example (the model must already be installed):
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=your-installed-model

# Optional accounts: Auth.js + Google OAuth + PostgreSQL.
# AUTH_ENABLED=true fails closed if any required auth setting is missing.
# Without auth settings, the loopback-only local reader remains available.
AUTH_ENABLED=false
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
APP_ORIGIN=http://127.0.0.1:4173
# Generate distinct random values for AUTH_SECRET and POSTGRES_PASSWORD.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://ai_read:REPLACE_WITH_POSTGRES_PASSWORD@127.0.0.1:54341/ai_read?schema=public
# Google Web OAuth redirect URIs (register both for local development):
# http://127.0.0.1:4173/api/auth/callback/google
# http://localhost:4173/api/auth/callback/google
# Use APP_ORIGIN for deployment. Do not set AUTH_URL to one loopback alias;
# Auth.js derives the callback origin from proxy-validated request headers.
