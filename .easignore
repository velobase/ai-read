*.mobileprovision
*.ipa
*.xcarchive/
work/

# Regenerate the app host in the production build. Keep modules/*/ios sources.
/apps/mobile/ios/
/apps/mobile/android/

# Generated Web-only output.
/src/generated/prisma/
/public/pdfjs/
